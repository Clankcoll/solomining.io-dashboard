# Environment Configuration for Solomining.io Dashboard
# Copy this file to .env and customize with your settings

# ===================================================================
# REQUIRED: Your Mining Address
# ===================================================================
# Get this from your solomining.io account
# Works with any coin: BCH, BTC, LTC, etc.
# Examples:
#   BCH: bitcoincash:qr6m7j9njldwwzlg9v7v53unlr4jkmx6eylep8ekg2
#   BTC: bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
BCH_ADDRESS=bitcoincash:YOUR_ADDRESS_HERE

# ===================================================================
# Mining Pool Configuration
# ===================================================================
# Change this if you're mining a different coin or using a different pool
POOL_URL=https://bchnode.solomining.io/address.php

# How often to scrape mining statistics (in seconds)
# Default: 60 seconds
SCRAPE_INTERVAL=60

# ===================================================================
# Grafana Configuration
# ===================================================================
# Default admin credentials (CHANGE THESE IN PRODUCTION!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===================================================================
# Advanced Options (usually don't need to change these)
# ===================================================================
# Prometheus data retention period
# PROMETHEUS_RETENTION=90d

# Grafana port (if 3000 is already in use)
# GRAFANA_PORT=3000

# Prometheus port (if 9090 is already in use)
# PROMETHEUS_PORT=9090
